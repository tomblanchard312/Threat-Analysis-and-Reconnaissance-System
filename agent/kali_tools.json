  "common_commands": {
    "port_scan": "nmap -sV -sC -p- <target>",
    "quick_scan": "nmap -sV -sC <target>",
    "vuln_scan": "nmap --script vuln <target>",
    "dir_brute": "gobuster dir -u http://<target> -w /usr/share/wordlists/dirb/common.txt",
    "subdomain_enum": "gobuster dns -d <domain> -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt",
    "web_vuln_scan": "nikto -h http://<target>",
    "smb_enum": "enum4linux -a <target>",
    "smb_shares": "smbclient -L //<target> -N",
    "sql_injection": "sqlmap -u 'http://<target>/page?id=1' --batch",
    "hydra_ssh": "hydra -l <user> -P /usr/share/wordlists/rockyou.txt ssh://<target>",
    "crack_hash": "john --wordlist=/usr/share/wordlists/rockyou.txt <hashfile>",
    "searchsploit": "searchsploit <service> <version>",

    "osint_email_harvest": "theHarvester -d <domain> -b all -l 500",
    "osint_subdomain_amass": "amass enum -passive -d <domain>",
    "osint_subdomain_active": "amass enum -active -d <domain> -brute",
    "osint_sublist3r": "sublist3r -d <domain> -o subdomains.txt",
    "osint_username_search": "sherlock <username> --print-found",
    "osint_email_check": "holehe <email>",
    "osint_dns_recon": "dnsrecon -d <domain> -t std,brt,srv,axfr",
    "osint_whois": "whois <domain>",
    "osint_dmitry": "dmitry -winsepfb <domain>",
    "osint_fierce": "fierce --domain <domain>",
    "osint_metadata_pdf": "exiftool <file.pdf>",
    "osint_metagoofil": "metagoofil -d <domain> -t pdf,doc,xls -l 100 -o ./metadata",
    "osint_photon_crawl": "photon -u https://<domain> -o ./photon_output --dns --keys",
    "osint_spiderfoot_scan": "spiderfoot -s <domain> -o ./spiderfoot_output",
    "osint_recon_ng_setup": "recon-ng -w <workspace>",
    "osint_shodan_host": "shodan host <ip>",
    "osint_shodan_search": "shodan search <query>",
    "osint_h8mail": "h8mail -t <email>",
    "osint_socialscan": "socialscan <email_or_username>",
    "osint_web_recon": "finalrecon --full https://<domain>"
  },
  "osint_workflows": {
    "domain_recon": {
      "description": "Complete domain reconnaissance workflow",
      "steps": [
        "whois <domain>",
        "dig <domain> any +noall +answer",
        "theHarvester -d <domain> -b all -l 500",
        "amass enum -passive -d <domain>",
        "dnsrecon -d <domain> -t std"
      ]
    },
    "person_osint": {
      "description": "OSINT on a person/username",
      "steps": [
        "sherlock <username> --print-found",
        "holehe <email> (if email known)",
        "theHarvester -d <company> -b linkedin"
      ]
    },
    "company_recon": {
      "description": "Corporate reconnaissance workflow",
      "steps": [
        "whois <domain>",
        "theHarvester -d <domain> -b all",
        "metagoofil -d <domain> -t pdf,doc,xls -l 100",
        "amass enum -d <domain>",
        "shodan search org:<company_name>"
      ]
    },
    "website_footprint": {
      "description": "Website footprinting and technology stack",
      "steps": [
        "whatweb -a 3 https://<domain>",
        "wafw00f https://<domain>",
        "photon -u https://<domain> -o ./output --dns --keys",
        "finalrecon --full https://<domain>"
      ]
    }
  }
}
