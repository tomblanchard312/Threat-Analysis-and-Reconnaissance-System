{
  "description": "Kali Docker tools available to HTB Pentest Agent",
  "categories": {
    "network_recon": {
      "name": "Network Reconnaissance",
      "tools": {
        "nmap": "Port scanning, service detection, OS fingerprinting, vulnerability scanning",
        "masscan": "High-speed port scanner for large networks",
        "netcat": "Network utility for reading/writing across connections (nc)",
        "dig": "DNS lookup utility (from dnsutils)",
        "nslookup": "DNS query tool",
        "host": "DNS lookup utility",
        "whois": "Domain/IP registration lookup",
        "traceroute": "Network path tracing",
        "tcpdump": "Packet capture and analysis",
        "ping": "ICMP connectivity testing",
        "arp": "ARP table manipulation",
        "netstat": "Network statistics and connections",
        "ss": "Socket statistics (modern netstat)"
      }
    },
    "web_testing": {
      "name": "Web Application Testing",
      "tools": {
        "gobuster": "Directory/file brute-forcing, DNS subdomain enumeration",
        "dirb": "Web content scanner",
        "nikto": "Web server vulnerability scanner",
        "whatweb": "Web technology fingerprinting",
        "wfuzz": "Web fuzzer for parameters, directories, headers",
        "ffuf": "Fast web fuzzer",
        "curl": "HTTP client for manual requests",
        "wget": "File downloader, recursive site mirroring",
        "httpie": "User-friendly HTTP client (http command)"
      }
    },
    "exploitation": {
      "name": "Exploitation Frameworks",
      "tools": {
        "msfconsole": "Metasploit Framework console",
        "msfvenom": "Payload generator",
        "searchsploit": "Exploit database search (exploitdb)"
      }
    },
    "password_attacks": {
      "name": "Password Cracking & Brute Force",
      "tools": {
        "john": "John the Ripper password cracker",
        "hashcat": "GPU-accelerated hash cracker",
        "hydra": "Network login brute-forcer (SSH, FTP, HTTP, SMB, etc.)"
      },
      "wordlists": [
        "/usr/share/wordlists/rockyou.txt",
        "/usr/share/seclists/Passwords/",
        "/usr/share/seclists/Usernames/",
        "/usr/share/seclists/Discovery/"
      ]
    },
    "smb_windows": {
      "name": "SMB & Windows Enumeration",
      "tools": {
        "smbclient": "SMB/CIFS client for file shares",
        "enum4linux": "Windows/Samba enumeration",
        "crackmapexec": "Swiss army knife for Windows/AD (cme)",
        "impacket-psexec": "Remote command execution via SMB",
        "impacket-smbexec": "SMB-based command execution",
        "impacket-wmiexec": "WMI-based command execution",
        "impacket-secretsdump": "Dump SAM/NTDS secrets",
        "impacket-GetNPUsers": "AS-REP Roasting",
        "impacket-GetUserSPNs": "Kerberoasting"
      }
    },
    "ldap_ad": {
      "name": "LDAP & Active Directory",
      "tools": {
        "ldapsearch": "LDAP query tool",
        "ldapwhoami": "LDAP authentication test"
      }
    },
    "sql_database": {
      "name": "SQL & Database Attacks",
      "tools": {
        "sqlmap": "Automatic SQL injection and database takeover"
      }
    },
    "python_tools": {
      "name": "Python Security Libraries",
      "tools": {
        "pwntools": "CTF/exploit development library",
        "impacket": "Network protocol library (SMB, LDAP, Kerberos)",
        "requests": "HTTP library for custom scripts",
        "beautifulsoup4": "HTML/XML parsing for web scraping"
      }
    }
  },
  "common_commands": {
    "port_scan": "nmap -sV -sC -p- <target>",
    "quick_scan": "nmap -sV -sC <target>",
    "vuln_scan": "nmap --script vuln <target>",
    "dir_brute": "gobuster dir -u http://<target> -w /usr/share/wordlists/dirb/common.txt",
    "subdomain_enum": "gobuster dns -d <domain> -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt",
    "web_vuln_scan": "nikto -h http://<target>",
    "smb_enum": "enum4linux -a <target>",
    "smb_shares": "smbclient -L //<target> -N",
    "sql_injection": "sqlmap -u 'http://<target>/page?id=1' --batch",
    "hydra_ssh": "hydra -l <user> -P /usr/share/wordlists/rockyou.txt ssh://<target>",
    "crack_hash": "john --wordlist=/usr/share/wordlists/rockyou.txt <hashfile>",
    "searchsploit": "searchsploit <service> <version>"
  }
}
