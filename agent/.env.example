# TARS Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ── ElevenLabs (Voice & Transcription) ──────────────────────────
# Get yours at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_api_key_here
TARS_VOICE_ID=your_voice_id_here
# ── OSINT API Keys ──────────────────────────────────────────────
# Shodan - Internet-wide scanning (100 queries/month free)
# https://account.shodan.io/
SHODAN_API_KEY=your_shodan_key_here

# VirusTotal - Threat intelligence (500 lookups/day free)
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# GitHub - Code/repo search (5,000 requests/hour)
# https://github.com/settings/tokens
GITHUB_API_KEY=your_github_token_here

# SecurityTrails - DNS & historical data (50 queries/month free)
# https://securitytrails.com/app/account
SECURITYTRAILS_API_KEY=your_securitytrails_key_here

# Hunter.io - Email discovery (25 searches/month free)
# https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_key_here

# Censys - Certificate transparency (250 queries/month free)
# https://search.censys.io/account/api
CENSYS_API_ID=your_censys_id_here
CENSYS_API_SECRET=your_censys_secret_here
