{
  "transcription_enabled": false,
  "font_size": 14,
  "context_prompt": "",
  "auto_load_session": false,
  "auto_execute_task_plan": false,
  "api_keys": {
    "shodan": "YOUR_SHODAN_API_KEY",
    "github": "YOUR_GITHUB_TOKEN",
    "virustotal": "YOUR_VT_API_KEY",
    "hunter": "YOUR_HUNTER_API_KEY"
  },
  "model_settings": {
    "primary_model": "htb-pentest",
    "planning_model": "glm-4.7-flash",
    "vision_model": "glm-4.6v",
    "use_anthropic_api": false,
    "auto_route_models": true,
    "enable_thinking_mode": true,
    "show_model_indicator": true
  },
  "mcp_servers": {
    "pentest-mcp": {
      "enabled": false,
      "name": "Pentest MCP",
      "description": "Security testing: nmap, gobuster, nikto, john, hashcat",
      "command": "npx",
      "args": ["-y", "pentest-mcp"],
      "category": "pentesting"
    },
    "mcp-shell": {
      "enabled": false,
      "name": "Shell Server",
      "description": "Secure shell command execution",
      "command": "npx",
      "args": ["-y", "@mako10k/mcp-shell-server"],
      "category": "system"
    },
    "filesystem-mcp": {
      "enabled": false,
      "name": "Filesystem",
      "description": "Secure file read/write operations",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\"],
      "category": "system"
    },
    "fetch-mcp": {
      "enabled": false,
      "name": "Web Fetch",
      "description": "Fetch and convert web content for LLM usage",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "category": "web"
    },
    "memory-mcp": {
      "enabled": false,
      "name": "Memory",
      "description": "Knowledge graph-based persistent memory",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "category": "system"
    }
  }
}
