{
  "transcription_enabled": true,
  "font_size": 14,
  "context_prompt": "",
  "mcp_servers": {
    "pentest-mcp": {
      "enabled": false,
      "name": "Pentest MCP",
      "description": "Security testing tools via MCP protocol",
      "url": "npx pentest-mcp",
      "category": "pentesting",
      "tools": {
        "nmap": {
          "description": "Network port scanning and service detection",
          "usage": "nmap -sV -sC <target>",
          "examples": [
            "nmap -sV 10.10.10.1",
            "nmap -p- -T4 10.10.10.1"
          ]
        },
        "gobuster": {
          "description": "Directory and file brute-forcing",
          "usage": "gobuster dir -u <url> -w <wordlist>",
          "examples": [
            "gobuster dir -u http://10.10.10.1 -w common.txt"
          ]
        },
        "nikto": {
          "description": "Web server vulnerability scanner",
          "usage": "nikto -h <target>",
          "examples": [
            "nikto -h http://10.10.10.1"
          ]
        },
        "john": {
          "description": "Password hash cracking",
          "usage": "john --wordlist=<wordlist> <hashfile>",
          "examples": [
            "john --wordlist=rockyou.txt hashes.txt"
          ]
        },
        "hashcat": {
          "description": "Advanced password recovery",
          "usage": "hashcat -m <mode> <hashfile> <wordlist>",
          "examples": [
            "hashcat -m 0 hash.txt rockyou.txt"
          ]
        }
      }
    },
    "mcp-kali-server": {
      "enabled": true,
      "name": "Kali Server",
      "description": "Full Kali toolkit with SSH/shell management",
      "url": "http://localhost:5000",
      "category": "pentesting",
      "tools": {
        "shell": {
          "description": "Execute shell commands in Kali environment",
          "usage": "Any shell command",
          "examples": [
            "ls -la",
            "whoami",
            "ifconfig"
          ]
        },
        "ssh_connect": {
          "description": "Establish SSH connection to target",
          "usage": "ssh <user>@<host>",
          "examples": [
            "ssh root@10.10.10.1"
          ]
        },
        "file_transfer": {
          "description": "Transfer files to/from targets",
          "usage": "scp, wget, curl operations",
          "examples": [
            "scp file.txt user@host:/tmp/"
          ]
        }
      }
    },
    "azure-mcp": {
      "enabled": false,
      "name": "Azure MCP",
      "description": "Azure cloud services integration",
      "url": "npx @azure/mcp",
      "category": "cloud",
      "tools": {
        "az_login": {
          "description": "Authenticate to Azure",
          "usage": "az login",
          "examples": [
            "az login --service-principal"
          ]
        },
        "az_vm": {
          "description": "Manage Azure VMs",
          "usage": "az vm <command>",
          "examples": [
            "az vm list",
            "az vm show -n myvm -g mygroup"
          ]
        },
        "az_storage": {
          "description": "Azure storage operations",
          "usage": "az storage <command>",
          "examples": [
            "az storage account list"
          ]
        },
        "az_keyvault": {
          "description": "Azure Key Vault operations",
          "usage": "az keyvault <command>",
          "examples": [
            "az keyvault secret list --vault-name myvault"
          ]
        }
      }
    },
    "aws-mcp": {
      "enabled": false,
      "name": "AWS MCP",
      "description": "AWS CLI in Docker container",
      "url": "npx @aws/mcp",
      "category": "cloud",
      "tools": {
        "aws_ec2": {
          "description": "EC2 instance management",
          "usage": "aws ec2 <command>",
          "examples": [
            "aws ec2 describe-instances"
          ]
        },
        "aws_s3": {
          "description": "S3 bucket operations",
          "usage": "aws s3 <command>",
          "examples": [
            "aws s3 ls",
            "aws s3 cp file s3://bucket/"
          ]
        },
        "aws_iam": {
          "description": "IAM user/role management",
          "usage": "aws iam <command>",
          "examples": [
            "aws iam list-users"
          ]
        },
        "aws_lambda": {
          "description": "Lambda function operations",
          "usage": "aws lambda <command>",
          "examples": [
            "aws lambda list-functions"
          ]
        }
      }
    },
    "k8s-mcp": {
      "enabled": false,
      "name": "Kubernetes MCP",
      "description": "kubectl, helm, istioctl commands",
      "url": "npx k8s-mcp-server",
      "category": "infrastructure",
      "tools": {
        "kubectl": {
          "description": "Kubernetes cluster management",
          "usage": "kubectl <command>",
          "examples": [
            "kubectl get pods",
            "kubectl describe pod <name>"
          ]
        },
        "helm": {
          "description": "Kubernetes package manager",
          "usage": "helm <command>",
          "examples": [
            "helm list",
            "helm install myapp ./chart"
          ]
        },
        "istioctl": {
          "description": "Istio service mesh management",
          "usage": "istioctl <command>",
          "examples": [
            "istioctl analyze"
          ]
        }
      }
    },
    "mcp-shell": {
      "enabled": false,
      "name": "Shell Server",
      "description": "Secure shell operations",
      "url": "npx mcp-shell-server",
      "category": "system",
      "tools": {
        "exec": {
          "description": "Execute shell commands securely",
          "usage": "Any shell command",
          "examples": [
            "ls",
            "pwd",
            "cat file.txt"
          ]
        },
        "env": {
          "description": "Manage environment variables",
          "usage": "Get/set environment",
          "examples": [
            "echo $PATH"
          ]
        }
      }
    },
    "filesystem-mcp": {
      "enabled": false,
      "name": "Filesystem",
      "description": "Secure file operations",
      "url": "npx @modelcontextprotocol/server-filesystem",
      "category": "system",
      "tools": {
        "read_file": {
          "description": "Read file contents",
          "usage": "Read contents of a file",
          "examples": [
            "Read /etc/passwd"
          ]
        },
        "write_file": {
          "description": "Write to files",
          "usage": "Write content to a file",
          "examples": [
            "Write payload to exploit.py"
          ]
        },
        "list_directory": {
          "description": "List directory contents",
          "usage": "List files in directory",
          "examples": [
            "List /var/www/html"
          ]
        },
        "search_files": {
          "description": "Search for files by pattern",
          "usage": "Find files matching pattern",
          "examples": [
            "Find all .php files"
          ]
        }
      }
    },
    "git-mcp": {
      "enabled": false,
      "name": "Git Server",
      "description": "Git repository operations",
      "url": "npx @modelcontextprotocol/server-git",
      "category": "development",
      "tools": {
        "git_clone": {
          "description": "Clone a repository",
          "usage": "git clone <repo>",
          "examples": [
            "git clone https://github.com/user/repo"
          ]
        },
        "git_status": {
          "description": "Show repository status",
          "usage": "git status",
          "examples": [
            "git status"
          ]
        },
        "git_diff": {
          "description": "Show changes",
          "usage": "git diff",
          "examples": [
            "git diff HEAD~1"
          ]
        },
        "git_log": {
          "description": "Show commit history",
          "usage": "git log",
          "examples": [
            "git log --oneline -10"
          ]
        }
      }
    }
  }
}