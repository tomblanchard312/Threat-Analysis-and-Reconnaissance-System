{
  "name": "domain_reconnaissance",
  "description": "Gathering information about domains and websites",
  "tools": [
    {
      "name": "whois",
      "url": "builtin",
      "usage": "whois domain.com",
      "description": "Query domain registration info"
    },
    {
      "name": "amass",
      "url": "https://github.com/owasp-amass/amass",
      "usage": "amass enum -d domain.com",
      "description": "In-depth attack surface mapping"
    },
    {
      "name": "subfinder",
      "url": "https://github.com/projectdiscovery/subfinder",
      "usage": "subfinder -d domain.com",
      "description": "Fast passive subdomain enumeration"
    },
    {
      "name": "dnsrecon",
      "url": "https://github.com/darkoperator/dnsrecon",
      "usage": "dnsrecon -d domain.com",
      "description": "DNS enumeration script"
    },
    {
      "name": "dig",
      "url": "builtin",
      "usage": "dig domain.com ANY",
      "description": "DNS lookup utility"
    },
    {
      "name": "crt.sh",
      "url": "https://crt.sh",
      "usage": "Web search for SSL certificates",
      "description": "Certificate transparency logs"
    },
    {
      "name": "dnsdumpster",
      "url": "https://dnsdumpster.com",
      "usage": "Web-based DNS recon",
      "description": "DNS recon and research"
    },
    {
      "name": "securitytrails",
      "url": "https://securitytrails.com",
      "usage": "Web/API for historical DNS",
      "description": "Historical DNS data"
    },
    {
      "name": "builtwith",
      "url": "https://builtwith.com",
      "usage": "Web-based tech stack detection",
      "description": "Identify web technologies"
    },
    {
      "name": "wappalyzer",
      "url": "https://www.wappalyzer.com",
      "usage": "Browser extension or API",
      "description": "Identify technologies on websites"
    }
  ],
  "techniques": [
    "Enumerate subdomains with multiple tools",
    "Check historical DNS records for old IPs",
    "Search certificate transparency logs",
    "Identify technology stack for attack vectors",
    "Find related domains via reverse WHOIS",
    "Check robots.txt and sitemap.xml",
    "Use Wayback Machine for historical content"
  ]
}