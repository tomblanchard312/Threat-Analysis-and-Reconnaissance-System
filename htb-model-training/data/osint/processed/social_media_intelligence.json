      "usage": "twint -u username",
      "description": "Twitter/X scraping tool"
    },
    {
      "name": "instaloader",
      "url": "https://github.com/instaloader/instaloader",
      "usage": "instaloader profile username",
      "description": "Download Instagram photos and metadata"
    },
    {
      "name": "osintgram",
      "url": "https://github.com/Datalux/Osintgram",
      "usage": "Interactive Instagram OSINT",
      "description": "Instagram OSINT analysis"
    },
    {
      "name": "socialscan",
      "url": "https://github.com/iojw/socialscan",
      "usage": "socialscan -e email",
      "description": "Check email/username usage on platforms"
    },
    {
      "name": "GHunt",
      "url": "https://github.com/mxrch/GHunt",
      "usage": "ghunt email@gmail.com",
      "description": "Google account investigation"
    }
  ],
  "techniques": [
    "Analyze posting patterns and times",
    "Extract location data from posts",
    "Map social connections and followers",
