      "category": "Execute",
      "mitre": "T1218",
      "privileges": "User",
      "os": "Windows vista, Windows 7, Windows 8, Windows 8.1, Windows 10, Windows 11"
    },
    {
      "command": "wmic.exe /node:\"192.168.0.1\" process call create \"{CMD}\"",
